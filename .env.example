# Host-side values. docker-compose overrides DATABASE_URL and OLLAMA_BASE_URL with
# host.docker.internal for containers, so this file works for both `uv run` and compose.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# LLM provider: ollama | anthropic
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Source politeness
OVERPASS_URL=https://overpass-api.de/api/interpreter
SOCRATA_APP_TOKEN=
# Reddit official API (script app from https://www.reddit.com/prefs/apps, app-only OAuth)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=macos:venue-insight-pipeline:0.1 (portfolio project)
