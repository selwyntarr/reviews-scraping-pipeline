# Postgres (Supabase local stack default credentials)
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
# When running the CLI directly on the host instead of in Docker:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# LLM provider: ollama | anthropic
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Source politeness
OVERPASS_URL=https://overpass-api.de/api/interpreter
SOCRATA_APP_TOKEN=
REDDIT_USER_AGENT=venue-insight-pipeline/0.1 (portfolio project)
